# 7. Figura compuesta con patchwork --------------------------------------------

# Se crean versiones compactas de los gráficos 2, 4 y 5.
# Se reducen títulos, textos y márgenes para evitar superposiciones.

tema_panel <- tema_t4(base = 10) +
  theme(
    plot.title = element_text(
      size = 10, face = "bold", color = "#223C6A"
    ),
    plot.subtitle = element_text(size = 8),
    axis.title = element_text(size = 8),
    axis.text = element_text(size = 7),
    plot.caption = element_blank(),
    plot.margin = margin(10, 14, 10, 14)
  )


# PANEL A: informalidad por región --------------------------------------------

p2_comp <- ggplot(
  regional_informalidad,
  aes(x = tasa_informal, y = reorder(region_txt, tasa_informal))
) +
  geom_col(aes(fill = destacada), width = 0.7) +
  geom_vline(
    xintercept = tasa_nacional,
    color = "grey35",
    linetype = "dashed",
    linewidth = 0.7
  ) +
  geom_text(
    aes(label = percent(tasa_informal, accuracy = 0.1,
                        decimal.mark = ",")),
    hjust = -0.12,
    size = 2.8,
    color = "grey20"
  ) +
  scale_fill_manual(
    values = c("FALSE" = "#C7CCD1", "TRUE" = naranjo),
    guide = "none"
  ) +
  scale_x_continuous(
    labels = label_percent(accuracy = 1, decimal.mark = ","),
    expand = expansion(mult = c(0, 0.18))
  ) +
  coord_cartesian(
    xlim = c(0, max(regional_informalidad$tasa_informal) * 1.20)
  ) +
  labs(
    title = "Ñuble supera la tasa nacional de informalidad",
    subtitle = paste0(
      "Ñuble: ", percent(tasa_nuble, accuracy = 0.1, decimal.mark = ","),
      " | Nacional: ", percent(tasa_nacional, accuracy = 0.1, decimal.mark = ",")
    ),
    x = "Tasa de informalidad",
    y = NULL
  ) +
  tema_panel


# PANEL B: informalidad de mujeres frente a hombres ----------------------------

p4_comp <- ggplot(
  regional_sexo,
  aes(x = Hombres, y = Mujeres, color = destacada)
) +
  geom_abline(
    slope = 1,
    intercept = 0,
    color = "grey45",
    linetype = "dashed",
    linewidth = 0.7
  ) +
  geom_point(size = 2.5) +
  geom_text_repel(
    aes(label = region_txt),
    seed = 2026,
    size = 2.7,
    max.overlaps = Inf,
    max.iter = 10000,
    box.padding = 0.35,
    point.padding = 0.20,
    force = 1.5,
    min.segment.length = 0,
    show.legend = FALSE
  ) +
  scale_color_manual(
    values = c("FALSE" = "grey45", "TRUE" = naranjo),
    guide = "none"
  ) +
  scale_x_continuous(
    labels = label_percent(accuracy = 1, decimal.mark = ","),
    expand = expansion(mult = c(0, 0.05))
  ) +
  scale_y_continuous(
    labels = label_percent(accuracy = 1, decimal.mark = ","),
    expand = expansion(mult = c(0, 0.05))
  ) +
  coord_equal(
    xlim = c(0, limite_tasas),
    ylim = c(0, limite_tasas),
    clip = "off"
  ) +
  labs(
    title = paste0(
      "La informalidad femenina supera la masculina en ",
      n_regiones_mujer_mayor, " de 16 regiones"
    ),
    subtitle = "Sobre la diagonal: tasa femenina mayor",
    x = "Hombres",
    y = "Mujeres"
  ) +
  tema_panel +
  theme(
    plot.margin = margin(12, 20, 10, 20)
  )


# PANEL C: informalidad según tramo de edad -----------------------------------

p5_comp <- ggplot(
  informalidad_edad,
  aes(x = tramo_edad_txt, y = tasa_informal, group = 1)
) +
  geom_line(color = azul, linewidth = 0.9) +
  geom_point(color = naranjo, size = 2.2) +
  scale_y_continuous(
    labels = label_percent(accuracy = 1, decimal.mark = ",")
  ) +
  labs(
    title = "La informalidad vuelve a aumentar en edades mayores",
    subtitle = "Tasa ponderada por tramo de edad",
    x = "Tramo de edad",
    y = "Tasa de informalidad"
  ) +
  tema_panel +
  theme(
    axis.text.x = element_text(
      angle = 45, hjust = 1, vjust = 1, size = 7
    )
  )


# COMPOSICIÓN: A a la izquierda; B y C a la derecha ----------------------------

figura <- (p2_comp | (p4_comp / p5_comp)) +
  plot_layout(
    widths = c(1, 1.55)
  ) +
  plot_annotation(
    title = "La informalidad laboral cambia según región, sexo y edad",
    caption = paste0(
      "Fuente: ENE, mayo-julio de 2026. ",
      "Estimaciones ponderadas con fact_cal; personas ocupadas ",
      "(activ = 1) con formalidad identificada."
    ),
    tag_levels = "A",
    theme = theme(
      plot.title = element_text(
        size = 15, face = "bold", color = "#223C6A"
      ),
      plot.caption = element_text(size = 8, hjust = 0),
      plot.tag = element_text(size = 12, face = "bold")
    )
  )

# Mostrar la figura
figura


# EXPORTAR: PNG a 300 dpi y PDF vectorial -------------------------------------

ggsave(
  filename = "output/figuras/t4_p2_figura_compuesta.png",
  plot = figura,
  width = 18,
  height = 14,
  units = "in",
  dpi = 300
)

ggsave(
  filename = "output/figuras/t4_p2_figura_compuesta.pdf",
